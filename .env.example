# ============================================================
# OWASP JUICE SHOP — CONFIGURAÇÃO LOCAL
# ============================================================
# Copie este arquivo para .env antes de executar:
#
#   Copy-Item .env.example .env
#
# Nunca coloque chaves de API ou credenciais reais neste arquivo.
# ============================================================


# ------------------------------------------------------------
# 1. APLICAÇÃO
# ------------------------------------------------------------

# URL da instância local do Juice Shop.
JUICE_SHOP_BASE_URL=http://127.0.0.1:3000

# true  = executa o navegador com interface gráfica
# false = executa em modo headless
JUICE_SHOP_HEADLESS=false

# ------------------------------------------------------------
# 2. TIMEOUTS DA AUTOMAÇÃO
# ------------------------------------------------------------

JUICE_SHOP_ACTION_TIMEOUT_MS=10000
JUICE_SHOP_NAVIGATION_TIMEOUT_MS=15000
JUICE_SHOP_SCENARIO_TIMEOUT_SECONDS=180
JUICE_SHOP_MAX_STEPS=30

# ------------------------------------------------------------
# 3. DIRETÓRIOS DE EVIDÊNCIAS E RELATÓRIOS
# ------------------------------------------------------------

JUICE_SHOP_SCREENSHOT_DIR=reports/executions
JUICE_SHOP_REPORT_DIR=reports/executions


# ------------------------------------------------------------
# 4. USUÁRIO DE TESTE
# ------------------------------------------------------------

# Conta de teste criada na instância local do Juice Shop.
JUICE_SHOP_USER_EMAIL=teste@example.com
JUICE_SHOP_USER_PASSWORD=Teste@12345

JUICE_SHOP_SECURITY_QUESTION=Your favorite book?
JUICE_SHOP_SECURITY_ANSWER=a


# ------------------------------------------------------------
# 5. USUÁRIO ADMINISTRADOR DE TESTE
# ------------------------------------------------------------

# Conta utilizada pelos cenários administrativos.
# Estas credenciais são próprias do ambiente de treinamento local.
JUICE_SHOP_ADMIN_EMAIL=admin@juice-sh.op
JUICE_SHOP_ADMIN_PASSWORD=admin123


# ============================================================
# HUMANIZAÇÃO DA DOCUMENTAÇÃO COM LLM
# ============================================================

# Provedor utilizado pelo reporting/humanizer.
# Valores suportados pelo projeto:
#   claude
#   gemini
#   openai
#   kimi
#   groq
#
# Para a configuração atualmente validada:
REPORTING_LLM_PROVIDER=claude


# ------------------------------------------------------------
# 6. CLAUDE / ANTHROPIC — CONFIGURAÇÃO PRINCIPAL
# ------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
CLAUDE_LLM_MODEL=claude-sonnet-5


# ------------------------------------------------------------
# 7. GEMINI
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_LLM_MODEL=gemini-3.5-flash-lite


# ------------------------------------------------------------
# 8. OPENAI
# ------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-6.2-sol


# ------------------------------------------------------------
# 9. KIMI / MOONSHOT
# ------------------------------------------------------------

KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
KIMI_LLM_MODEL=kimi-k3.1-pro


# ------------------------------------------------------------
# 10. GROQ
# ------------------------------------------------------------

GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b
