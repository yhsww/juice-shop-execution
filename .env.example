JUICE_SHOP_BASE_URL=http://127.0.0.1:3000
JUICE_SHOP_HEADLESS=false
JUICE_SHOP_ACTION_TIMEOUT_MS=10000
JUICE_SHOP_NAVIGATION_TIMEOUT_MS=15000
JUICE_SHOP_SCENARIO_TIMEOUT_SECONDS=180
JUICE_SHOP_MAX_STEPS=30
JUICE_SHOP_SCREENSHOT_DIR=reports/executions
JUICE_SHOP_REPORT_DIR=reports/executions

# Test user created in the local Juice Shop instance.
JUICE_SHOP_USER_EMAIL=teste@example.com
JUICE_SHOP_USER_PASSWORD=Teste@12345
JUICE_SHOP_SECURITY_QUESTION=Your favorite book?
JUICE_SHOP_SECURITY_ANSWER=a

# Valores usados pelo cenário CEN-IDT-01 de cadastro.
# A pergunta "Your favorite book?" e a resposta "a" aparecem em material
# público de execução/avaliação do OWASP Juice Shop.

# OWASP Juice Shop administrator test account documented by the official companion guide.
# These credentials are intentionally vulnerable training-app credentials.
JUICE_SHOP_ADMIN_EMAIL=admin@juice-sh.op
JUICE_SHOP_ADMIN_PASSWORD=admin123

# Provedor da LLM usada para humanizar a documentação funcional.
# Groq é o padrão para evitar dependência de créditos pagos da OpenAI.
# A chave deve ser informada somente no .env local.
REPORTING_LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Gemini
# A API do Gemini possui modelos com acesso gratuito sujeito aos limites do Free Tier.
# O projeto usa a camada OpenAI-compatible Chat Completions para manter o mesmo contrato.
# Fonte: https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_LLM_MODEL=gemini-3.8-flash

# Claude / Anthropic
# Claude exige uma chave Anthropic própria; o suporte não implica que a API seja gratuita.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
CLAUDE_LLM_MODEL=claude-sonnet-5

# Alternativa OpenAI:
# REPORTING_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_MODEL=gpt-6.2-sol

# Alternativa Kimi:
# REPORTING_LLM_PROVIDER=kimi
# KIMI_API_KEY=
# KIMI_API_BASE_URL=https://api.moonshot.ai/v1
# KIMI_LLM_MODEL=kimi-k3.1-pro
