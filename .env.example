JUICE_SHOP_BASE_URL=http://127.0.0.1:3000
JUICE_SHOP_HEADLESS=false
JUICE_SHOP_ACTION_TIMEOUT_MS=10000
JUICE_SHOP_NAVIGATION_TIMEOUT_MS=15000
JUICE_SHOP_SCENARIO_TIMEOUT_SECONDS=180
JUICE_SHOP_MAX_STEPS=30
JUICE_SHOP_SCREENSHOT_DIR=reports/executions
JUICE_SHOP_REPORT_DIR=reports/executions

# Test user created in the local Juice Shop instance.
JUICE_SHOP_USER_EMAIL=teste@example.com
JUICE_SHOP_USER_PASSWORD=Teste@12345
JUICE_SHOP_SECURITY_QUESTION=Your favorite book?
JUICE_SHOP_SECURITY_ANSWER=a

# Valores usados pelo cenário CEN-IDT-01 de cadastro.
# A pergunta "Your favorite book?" e a resposta "a" aparecem em material
# público de execução/avaliação do OWASP Juice Shop.

# OWASP Juice Shop administrator test account documented by the official companion guide.
# These credentials are intentionally vulnerable training-app credentials.
JUICE_SHOP_ADMIN_EMAIL=admin@juice-sh.op
JUICE_SHOP_ADMIN_PASSWORD=admin123

# LLM usada para humanizar a documentação funcional dos cenários.
# Deixe OPENAI_API_KEY vazio para manter a geração determinística.
OPENAI_API_KEY=
REPORTING_LLM_MODEL=gpt-6.2-sol
